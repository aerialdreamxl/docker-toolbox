[program:hermes-dashboard]
command=gosu ubuntu:ubuntu /bin/bash -c "hermes dashboard --no-open --port 9119 --host 0.0.0.0"
directory=/home/ubuntu
user=root
autostart=true
autorestart=true
stdout_logfile=/var/log/supervisor/hermes-dashboard.log
stderr_logfile=/var/log/supervisor/hermes-dashboard.log
